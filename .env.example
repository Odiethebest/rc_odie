APP_NAME=Reliable HTTP Notification Service
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_service
DATABASE_ECHO=false
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=60

POSTGRES_DB=notification_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
API_PORT=8000
MOCK_VENDOR_PORT=9000
